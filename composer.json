{
  "name": "jacyimp/api-platform-operation-cache",
  "description": "Operation-level response caching for API Platform",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "api-platform",
    "cache",
    "caching",
    "response-cache",
    "symfony"
  ],
  "homepage": "https://github.com/jacyimp/api-platform-operation-cache",
  "support": {
    "issues": "https://github.com/jacyimp/api-platform-operation-cache/issues",
    "source": "https://github.com/jacyimp/api-platform-operation-cache"
  },
  "authors": [
    {
      "name": "Jacy"
    }
  ],
  "require": {
    "php": "^8.2",
    "api-platform/metadata": "^3.4 || ^4.0",
    "psr/cache": "^3.0",
    "symfony/config": "^6.4 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2.13",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.5",
    "slevomat/coding-standard": "^8.31",
    "squizlabs/php_codesniffer": "^4.0.4",
    "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "JacyImp\\ApiPlatformOperationCache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JacyImp\\ApiPlatformOperationCache\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "phpcs",
    "cs:fix": "phpcbf",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "check": [
      "@composer validate --strict",
      "@cs",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
